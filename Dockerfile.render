# Render-parity local image (Docker Desktop). Not used by Render itself.
# Mimics bash render_start.sh + gunicorn -c gunicorn.conf.py NHL77FINAL:app
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=10000 \
    RENDER=1 \
    PL_EAGER_WARM=0 \
    PL_WEB_WARM=0 \
    PL_BOOT_GRACE_S=180 \
    PL_BUILD_SLOTS=1 \
    GUNICORN_THREADS=4 \
    MALLOC_ARENA_MAX=2 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      libgomp1 \
      curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/render/project/src

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p /data/.cache \
 && if [ -f sports_predictions_original.db ]; then \
      cp sports_predictions_original.db /data/sports_predictions_original.db; \
    fi

EXPOSE 10000

# Same shape as Render: bind $PORT, one gthread worker, config from gunicorn.conf.py
CMD ["gunicorn", "-c", "gunicorn.conf.py", "NHL77FINAL:app"]

# Copy to .env.local for local sandbox (gitignored)
# cp .env.local.example .env.local

SECRET_KEY=local-dev-only-change-me

# Optional: override SQLite path (default: ./sports_predictions_original.db)
# DATABASE_PATH=/path/to/sports_predictions_original.db

# Comma-separated admin emails — get auto-premium + can log in with ADMIN_PASSWORD
ADMIN_EMAILS=admin@predictionlab.local,nmesghali@gmail.com

# Password auto-seeded on app startup for every ADMIN_EMAILS entry
ADMIN_PASSWORD=sandbox-admin-2026

# Leave blank for local — Google/Stripe not required on localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
